flowchart TB
    subgraph Producers["Event producers (any goroutine)"]
        CmdW["CmdWidget · SubmitMsg"]
        GDB["GDB / Delve PTY readers"]
        Lua["Lua jobs · exec panes"]
        Widgets["Other widgets"]
    end

    subgraph Wake["Wake the UI thread · termforge"]
        PI["App.PostInterrupt(payload)"]
        Post["screen.PostEvent · EventInterrupt"]
        Poll["PollEvent · App.Run"]
    end

    subgraph Shell["Application shell · DebuggerApp"]
        HI["HandleInterrupt(ev)"]
        Str["string payload · gdb-exit, pane forward"]
        Disp["platform.EventBus.Dispatch(data)"]
    end

    subgraph Handlers["Typed subscribers · (*Ctl).Register(bus)"]
        Console["consoleCtl · GdbOutputMsg"]
        Cmd["cmdCtl · SubmitMsg"]
        Search["searchCtl · search text / submit"]
        Asm["asmCtl · refresh / browse"]
    end

    CmdW --> PI
    GDB --> PI
    Lua --> PI
    Widgets --> PI
    PI --> Post --> Poll --> HI
    HI --> Str
    HI --> Disp
    Disp --> Console
    Disp --> Cmd
    Disp --> Search
    Disp --> Asm
