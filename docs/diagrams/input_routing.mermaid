flowchart TB
    Run["App.Run loop · termforge"]
    Poll["PollEvent · tcell"]
    KeyRoute["App.HandleKey · mode handler for AppState.Mode()"]
    Resize["App.UpdateCanvas"]
    Interrupt["AppApi.HandleInterrupt"]
    Global["withGlobalKeys · activity + confirm gates"]
    Router["DebuggerApp mode handler"]
    Trie["KeyBindingRegistry.HandleKey · key sequences"]
    Tab["TabWidget.HandleEvent"]
    Cmd["CmdWidget.HandleEvent"]
    Bus["platform.EventBus.Dispatch"]

    Run --> Poll
    Poll -->|"EventKey"| KeyRoute
    Poll -->|"EventResize"| Resize
    Poll -->|"EventInterrupt"| Interrupt
    KeyRoute --> Global --> Router
    Router -->|"ModeNormal"| Trie
    Router -->|"ModeNormal"| Tab
    Router -->|"ModeNormal · colon"| Cmd
    Router -->|"ModeCommand / ModeSearch"| Cmd
    Router -->|"ModeLua"| Tab
    Interrupt --> Bus
